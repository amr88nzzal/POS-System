# ==========================================
# POS System Environment Configuration
# ==========================================

# Application Port (Default: 3100)
PORT=3100

# Application Public Base URL
APP_URL=http://localhost:3100

# ==========================================
# Database Connection (PostgreSQL)
# ==========================================
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_password_2026
POSTGRES_DB=pos_db
POSTGRES_PORT=5432

# Database Host (For Docker: 'postgres', for external host: IP/hostname)
SQL_HOST=postgres
SQL_PORT=5432
SQL_USER=pos_user
SQL_PASSWORD=pos_password_2026
SQL_DB_NAME=pos_db

# Alternative single connection string format if used:
# DATABASE_URL=postgres://pos_user:pos_password_2026@postgres:5432/pos_db

# ==========================================
# AI / External APIs
# ==========================================
# GEMINI_API_KEY: Optional - Required if using Gemini AI Features
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Optional if Firebase sync is enabled)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_PROJECT_ID=your-project-id
